# CampusMind AI Environment Configuration

# Project Metadata
PROJECT_NAME="CampusMind AI"
API_V1_STR="/api"
ENVIRONMENT=development
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
ALLOW_FACULTY_REGISTRATION=true

# Security & JWT Authentication
SECRET_KEY="replace-with-a-random-secret-of-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local default (SQLite):
DATABASE_URL="sqlite:///./campusmind.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Hugging Face model cache (set to a persistent path in production)
HF_HOME="./.cache/huggingface"
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Optional External LLM Key (Core application works 100% locally with local Sentence-BERT & FAISS)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# Local development; Vercel production should use the deployed Render API URL.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
